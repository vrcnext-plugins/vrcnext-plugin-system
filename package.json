{
  "name": "vrcnext-plugin-system",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin runtime, typed API and installer for VRCNext.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "./scripts/build.sh",
    "check": "./scripts/check.sh",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "install:vrcnext": "./scripts/install-into-vrcnext.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
